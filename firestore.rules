rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo puede leer/escribir quien haya iniciado sesión (con el usuario
    // que crees en Firebase Authentication). Así, aunque alguien tenga la
    // URL de la app, no puede tocar los datos sin las credenciales.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
